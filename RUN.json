{
  "runcontract": 1,
  "services": [
    {
      "name": "frontend",
      "dir": "frontend",
      "stack": "web-vite",
      "kind": "server",
      "install": [["npm", "install"]],
      "start": ["node", "node_modules/vite/bin/vite.js", "--host", "127.0.0.1", "--port", "${PORT}"],
      "port": 5173,
      "port_env": "PORT",
      "health": { "path": "/", "expect_status": [200] }
    }
  ]
}
