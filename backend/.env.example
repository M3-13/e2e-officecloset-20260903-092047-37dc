# Copy this file to `.env` (or export the variables below) before starting locally.
# Every variable here is also declared in RUN.json, which the CI/QA harness executes.
#
# SECRET_KEY has no default and is never shipped — generate one per machine:
#   Linux/macOS: python -c "import secrets; print(secrets.token_hex(32))"
#   Windows:     py -c "import secrets; print(secrets.token_hex(32))"

DATABASE_URL=sqlite:///./dev.db
SECRET_KEY=
UPLOAD_DIR=./uploads
FRONTEND_ORIGIN=http://localhost:5173
MAX_UPLOAD_MB=5
